-- estado ativo (accent) dos botoes de toggle. chamado direto no clique (atualizacao
-- instantanea) e no open da wheel. tween suave via TweenService.
function refreshToggleButtons()
    local TS = game:GetService("TweenService")
    local ti = TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local function apply(btn, active)
        if not btn then return end
        local stroke = btn:FindFirstChild("ZenthraStroke")
        local strokeGrad = stroke and stroke:FindFirstChild("ZenthraStrokeGrad")
        if active then
            pcall(function() TS:Create(btn, ti, {BackgroundColor3 = Color3.fromRGB(248,248,250), BackgroundTransparency = 0.04}):Play() end)
            if stroke then
                stroke.Color = Color3.fromRGB(248,248,250)
                pcall(function() TS:Create(stroke, ti, {Transparency = 0.1}):Play() end)
                if strokeGrad then strokeGrad.Color = ColorSequence.new(Color3.fromRGB(255,255,255)) end
            end
            if btn:IsA("ImageButton") or btn:IsA("ImageLabel") then
                pcall(function() TS:Create(btn, ti, {ImageColor3 = Color3.fromRGB(7,7,9)}):Play() end)
            end
        else
            pcall(function() TS:Create(btn, ti, {BackgroundColor3 = Color3.fromRGB(0,0,0), BackgroundTransparency = 0.4}):Play() end)
            if stroke then
                stroke.Color = Color3.fromRGB(120,120,128)
                pcall(function() TS:Create(stroke, ti, {Transparency = 0.35}):Play() end)
                if strokeGrad then
                    strokeGrad.Color = ColorSequence.new{
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(235,235,238)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(90,90,96)),
                    }
                end
            end
            if btn:IsA("ImageButton") or btn:IsA("ImageLabel") then
                pcall(function() TS:Create(btn, ti, {ImageColor3 = Color3.fromRGB(210,210,214)}):Play() end)
            end
        end
    end
    apply(UI.EmoteWalkButton, State.emotesWalkEnabled)
    apply(UI.Favorite, State.favoriteEnabled)
    apply(UI.SpeedEmote, State.speedEmoteEnabled)
    apply(UI.Reload, getgenv().autoReloadEnabled == true)
end

AnimationSystem.GetIconColor = function(key)
    if themes and themes[AnimationSystem.currentThemeName] then
        local theme = themes[AnimationSystem.currentThemeName]
        if theme.IconColors and theme.IconColors[key] then
            return TableToColor(theme.IconColors[key])
        end
        return TableToColor(theme.ImageColor or {255, 255, 255})
    elseif State.EmoteTheme then
        local theme = State.EmoteTheme
        if theme.IconColors and theme.IconColors[key] then
            return TableToColor(theme.IconColors[key])
        end
        return theme.ImageColor or Color3.new(1, 1, 1)
    end
    return Color3.fromRGB(255, 255, 255)
end

